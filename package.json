{
  "name": "araojs",
  "version": "0.4.0",
  "description": "A slide engine for technical talks: Vue 3 + Vite, one fixed canvas, themes as tokens, PDF export",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubasace/araojs.git"
  },
  "homepage": "https://github.com/rubasace/araojs#readme",
  "bugs": {
    "url": "https://github.com/rubasace/araojs/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./vite/index.js",
    "./style.css": "./dist/arao.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "arao": "./bin/arao.js"
  },
  "files": [
    "dist",
    "vite",
    "bin",
    "docs",
    "!docs/assets",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepack": "vite build",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "hero-gif": "node scripts/hero-gif.mjs"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify/utils": "^3.1.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "playwright-core": "~1.64.0",
    "pug": "^3.0.4",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  }
}
