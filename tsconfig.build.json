{
  // The public types, emitted by `npm run build` into dist/types-tmp (scripts/bundle-types.mjs then
  // bundles them into dist/types/index.d.ts and vite.d.ts): the library's (src/index.ts)
  // and the Vite plugin's (vite/index.js, from its JSDoc).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types-tmp",
    "rootDir": "."
  },
  "include": ["src/index.ts", "src/env.d.ts", "vite/index.js"]
}
